<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Compose paints everything; this only needs to
         provide a dark, edge-to-edge window with no system action bar. -->
    <style name="Theme.VideoDownloader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen shown while the process starts (androidx core-splashscreen). -->
    <style name="Theme.VideoDownloader.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.VideoDownloader</item>
    </style>

</resources>
